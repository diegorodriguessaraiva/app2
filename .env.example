# ---- Classificação por IA (backend) ----
# Chave da API da Claude (Anthropic). Fica SOMENTE no servidor, nunca no navegador.
# Crie em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar (padrão: claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Opcional: porta do backend (padrão: 8787)
# PORT=8787

# ---- Integração com o Gmail (frontend) ----
# Client ID OAuth do Google Cloud (tipo "Web application").
# Crie em https://console.cloud.google.com/apis/credentials
# Ative a "Gmail API" e adicione a origem autorizada (ex.: http://localhost:5173).
VITE_GOOGLE_CLIENT_ID=
